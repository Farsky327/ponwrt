CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
# ---- ponwrt-2026102222 新增 ----
# USB 支持：RNDIS/CDC-ETHER USB 网卡、USB 存储、usbutils、udev
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_udev=y
# vantage 主题（Farsky327/packages fork 内定制版：Ponwrt 品牌 logo，详见该仓库 SYNC.md；仅主题，不带仪表盘应用）
# LuCI 应用
CONFIG_PACKAGE_luci-app-wolultra=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-iptv=y
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-app-gecoosac=y
CONFIG_PACKAGE_luci-app-vnt=y
CONFIG_PACKAGE_luci-app-easytier=y
# VNT / EasyTier 守护进程（上方 LuCI 应用依赖的二进制）
CONFIG_PACKAGE_vnt=y
CONFIG_PACKAGE_easytier=y
# VNT 服务端（vnts）：luci-app-vnt 的服务端配置/日志/版本检查都依赖 /usr/bin/vnts，
# 缺它时状态页每 3 秒刷一次 daemon.err（vnts: not found / curl: not found）
CONFIG_PACKAGE_vnts=y
# curl：luci-app-vnt / luci-app-easytier 的版本检查与 easytier 下载工具链都用 curl
CONFIG_PACKAGE_curl=y
# 排障工具箱（2026-10-24 用户要求）
# 注意：unzip 包自带 zipinfo（安装时建符号链接）；openssl 命令行在 openssl-util 子包；
#       lsblk 是基础仓库 util-linux 的子包；iwinfo 是 libiwinfo 的命令行子包
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_lsblk=y
# 中文语言包
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wolultra-zh-cn=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y
CONFIG_PACKAGE_luci-i18n-iptv-zh-cn=y
CONFIG_PACKAGE_luci-i18n-arpbind-zh-cn=y
CONFIG_PACKAGE_luci-i18n-gecoosac-zh-cn=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y
